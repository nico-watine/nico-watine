# ------------------------------------------------------------
# Enable rewrite rules for clean URLs and cache-busted assets
# ------------------------------------------------------------

RewriteEngine On



# ------------------------------------------------------------
# Extensionless PHP / HTML URLs
# ------------------------------------------------------------

# /page → /page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# /page → /page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# /page.php → /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.php\ HTTP/
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# /page.html → /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]


# ----------------------------------------------------------------------
# | File access                                                        |
# ----------------------------------------------------------------------

# Block access to hidden files, except .well-known
RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
RewriteRule (^|/)\. - [F,L]

# Block potentially sensitive backup/config/source files
RewriteRule \.(bak|conf|dist|fla|inc|ini|log|psd|sh|sql|swp|swo)$ - [F,L,NC]


# ------------------------------------------------------------
# Versioned static files / cache busting
# ------------------------------------------------------------

RewriteRule ^(js|css)/(.+)\.(.+)\.(js|css)$ $1/$2.$4 [L]

